# ─────────────────────────────────────────────────────────────
# Servicios Luxel — environment variables (root reference).
# Copy this file to .env.local in apps/web for local dev.
# Worker secrets go via `wrangler secret put` instead of .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# As of 2025 Supabase replaced the JWT-based anon/service_role keys with opaque
# tokens prefixed `sb_publishable_*` and `sb_secret_*`. Use the new keys; the
# code falls back to the legacy names below during the rotation window.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks (only set if you haven't rotated yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Name of the JWT template configured in Clerk dashboard that mints
# a Supabase-compatible JWT (with `role: authenticated` and `sub: <clerk_user_id>`).
CLERK_JWT_TEMPLATE_NAME=supabase
# Webhook signing secret for Clerk → /api/webhooks/clerk (used by svix to verify)
CLERK_WEBHOOK_SECRET=
# Dedicated auth pages (avoids the sign-in modal). After auth, land on the account.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# ── AI concierge ("Lux") — Anthropic Claude ──
# Powers the web chat assistant (natural-language quoting, coverage, availability).
# Without this key the chat degrades gracefully to a static fallback message.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8). Use claude-haiku-4-5 for lower cost.
# LUXEL_AI_MODEL=claude-opus-4-8
# Public WhatsApp number (E.164, e.g. 56912345678) used for human handoff links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog (optional external mirror) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── In-house monitoring (owned event store) ──
# The web app CAPTURES events into Supabase (analytics_events / leads). The
# operator DASHBOARD is a separate app — see apps/admin/.env.example.
# Salt used to one-way hash visitor IPs before storing (privacy). Set a random value.
LUXEL_ANALYTICS_SALT=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ── Transbank Webpay Plus ──
# Blank -> public integration (sandbox) off production; prod requires real creds.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=

# ── Dev-only payment simulation ──
# When =1 AND the matching provider key above is empty AND not production, the
# checkout route marks the booking paid + confirmed and returns to the account
# page — so the quote→book→pay→account journey is testable locally without a
# Stripe/MercadoPago account. Real provider keys always take precedence. Never
# has any effect in production.
# LUXEL_DEV_MOCK_PAYMENTS=1

# ── WhatsApp Cloud API (worker-owned) ──
# ALL WhatsApp lives in the Cloudflare worker — both inbound (Meta webhook) and
# outbound (forwarding a handed-off chat to the operator). Set these as worker
# Cloudflare secrets (`wrangler secret put …`), NOT on the web app:
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Operator/team number (E.164) that receives handed-off web chats and replies:
# LUXEL_OPERATOR_WHATSAPP=
# Shared secret the web app presents on POST {worker}/send (set on BOTH):
# INTERNAL_SEND_TOKEN=

# ── Web → worker bridge (the ONLY WhatsApp-related vars the web app needs) ──
# The web app forwards handed-off chats by calling the worker's /send route, so it
# holds no WhatsApp credentials — just the worker URL and the shared token above.
# WHATSAPP_WORKER_SEND_URL=https://luxel-whatsapp.<subdomain>.workers.dev/send
# INTERNAL_SEND_TOKEN=

# ── Human-support working hours (America/Santiago; only gates the human handoff) ──
# LUXEL_WORKING_DAYS=1,2,3,4,5,6   # 0=Sun … 6=Sat (default Mon–Sat)
# LUXEL_WORKING_OPEN=9             # hour 0–23 (default 9)
# LUXEL_WORKING_CLOSE=19           # hour 0–23 (default 19)

# ── Outbound email (Resend) — check-in notifications, confirmations ──
# Unset → email notifications no-op (no dep, fetch-based).
# RESEND_API_KEY=
# RESEND_FROM="Luxel <hola@luxel.cl>"

# ── Guest check-in identity encryption ──
# 32-byte key (hex or base64) that encrypts guest ID numbers at rest — required
# for the check-in ID field. Generate: openssl rand -hex 32
# LUXEL_PII_KEY=

# ── Hospitable (AirBnB channel) ──
# SaaS model: each host connects their OWN Hospitable account in the UI (token
# stored encrypted per customer). This env var is only a founder/dev fallback.
# HOSPITABLE_API_TOKEN=

# ── Dev-only stubs (NEVER set in production; real keys always take precedence) ──
# Simulate email notifications + AI drafting so the full host↔guest flow is
# testable without real Resend/OpenAI keys.
# LUXEL_DEV_MOCK=1
# Simulate payments — booking checkout AND AI-plan trial→active activation.
# LUXEL_DEV_MOCK_PAYMENTS=1
