# ─────────────────────────────────────────────────────────────
# Servicios Luxel — environment variables (root reference).
# Copy this file to .env.local in apps/web for local dev.
# Worker secrets go via `wrangler secret put` instead of .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# As of 2025 Supabase replaced the JWT-based anon/service_role keys with opaque
# tokens prefixed `sb_publishable_*` and `sb_secret_*`. Use the new keys; the
# code falls back to the legacy names below during the rotation window.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks (only set if you haven't rotated yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Name of the JWT template configured in Clerk dashboard that mints
# a Supabase-compatible JWT (with `role: authenticated` and `sub: <clerk_user_id>`).
CLERK_JWT_TEMPLATE_NAME=supabase
# Webhook signing secret for Clerk → /api/webhooks/clerk (used by svix to verify)
CLERK_WEBHOOK_SECRET=
# Dedicated auth pages (avoids the sign-in modal). After auth, land on the account.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# ── AI concierge ("Lux") — Anthropic Claude ──
# Powers the web chat assistant (natural-language quoting, coverage, availability).
# Without this key the chat degrades gracefully to a static fallback message.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8). Use claude-haiku-4-5 for lower cost.
# LUXEL_AI_MODEL=claude-opus-4-8
# Public WhatsApp number (E.164, e.g. 56912345678) used for human handoff links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog (optional external mirror) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── In-house monitoring (owned event store) ──
# The web app CAPTURES events into Supabase (analytics_events / leads). The
# operator DASHBOARD is a separate app — see apps/admin/.env.example.
# Salt used to one-way hash visitor IPs before storing (privacy). Set a random value.
LUXEL_ANALYTICS_SALT=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ── Dev-only payment simulation ──
# When =1 AND the matching provider key above is empty AND not production, the
# checkout route marks the booking paid + confirmed and returns to the account
# page — so the quote→book→pay→account journey is testable locally without a
# Stripe/MercadoPago account. Real provider keys always take precedence. Never
# has any effect in production.
# LUXEL_DEV_MOCK_PAYMENTS=1

# ── WhatsApp Cloud API (set as Cloudflare Worker secrets, not in apps/web) ──
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
