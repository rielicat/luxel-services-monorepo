# ─────────────────────────────────────────────────────────────
# Servicios Luxel — environment variables (root reference).
# Copy this file to .env.local in apps/web for local dev.
# Worker secrets go via `wrangler secret put` instead of .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Name of the JWT template configured in Clerk dashboard that mints
# a Supabase-compatible JWT (with `role: authenticated` and `sub: <clerk_user_id>`).
CLERK_JWT_TEMPLATE_NAME=supabase
# Webhook signing secret for Clerk → /api/webhooks/clerk (used by svix to verify)
CLERK_WEBHOOK_SECRET=

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── MercadoPago ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ── WhatsApp Cloud API (set as Cloudflare Worker secrets, not in apps/web) ──
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
