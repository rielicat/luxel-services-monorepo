# ─────────────────────────────────────────────────────────────
# Servicios Luxel — environment variables (root reference).
# Copy this file to apps/web/.env.local for local dev.
#
# Variables left BLANK below are load-bearing: the feature they gate is off
# until they are set, usually silently. Variables that stay commented out are
# genuinely optional or dev-only.
#
# The operator app has its own file (apps/admin/.env.example), and worker
# secrets go via `wrangler secret put`. What breaks without each variable, and
# which of the four places it belongs in, is in docs/ENV.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# As of 2025 Supabase replaced the JWT-based anon/service_role keys with opaque
# tokens prefixed `sb_publishable_*` and `sb_secret_*`. Use the new keys; the
# code falls back to the legacy names below during the rotation window.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks (only set if you haven't rotated yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Name of the JWT template configured in Clerk dashboard that mints
# a Supabase-compatible JWT (with `role: authenticated` and `sub: <clerk_user_id>`).
CLERK_JWT_TEMPLATE_NAME=supabase
# Webhook signing secret for Clerk → /api/webhooks/clerk (used by svix to verify)
CLERK_WEBHOOK_SECRET=
# Dedicated auth pages (avoids the sign-in modal). After auth, land on the account.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# ── AI concierge ("Lux") — OpenAI ──
# Powers the guest auto-replies and the in-app assistant. Without this key
# getOpenAI() returns null and the assistant answers NOTHING — no error is
# raised anywhere, it simply stops responding.
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini, which is enough for this tightly-scripted,
# tool-driven concierge. Point at a stronger tier only if you need it.
# OPENAI_MODEL=gpt-4o-mini
# Public WhatsApp number (E.164, e.g. 56912345678) used for human handoff links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Channel: the PMS mirror (Hospitable today, Guesty in progress) ──
# ONE central Luxel account holds every host's listings; hosts grant Luxel access
# and never log into the PMS themselves. This token IS that central operator
# credential — not a dev fallback. Which listings a customer can see is decided
# by listing_assignments, never by the token.
#
# Named for the role, not the vendor: the PMS has changed once already. The old
# HOSPITABLE_API_TOKEN is still read as a fallback, so it can be removed at any
# time without a matching deploy.
PROVIDER_API_KEY=

# Beds24 (API v2) — the provider being migrated to. Auth is a long-lived refresh
# token that mints short-lived access tokens, obtained by running
# `BEDS24_INVITE_CODE=… node scripts/beds24-setup.mjs` against an invite code
# generated at https://beds24.com/control3.php?pagetype=apiv2
#
# ⚠ The refresh token DIES after 30 days without use, silently. The scheduled
# sync exercises it; if sync stops for a month the connection must be re-made.
BEDS24_REFRESH_TOKEN=
# Optional shared secret for the inbound webhook (/api/channels/hospitable?secret=…)
# HOSPITABLE_WEBHOOK_SECRET=

# ── Scheduled sync ──
# Guards /api/cron/sync. When this is UNSET the route's check
# short-circuits and accepts unauthenticated requests — and a sync is not
# read-only: it messages guests and triggers AI replies. Treat as required in
# production. Generate: openssl rand -hex 32
# The caller is .github/workflows/sync-cron.yml (NOT vercel.json — a sub-daily
# cron there is rejected on Hobby and silently blocks every deploy, see
# c64c945). The same value must be set as a GitHub repo secret.
CRON_SECRET=

# ── Dynamic pricing (PriceLabs) ──
# Also a single central account, gated per property by the price-optimization
# add-on. Unset → the pricing panel reports unavailable.
PRICELABS_API_KEY=

# ── Outbound email (Resend) — check-in and cleaning-crew notifications ──
# Unset → emailConfigured() is false, sends are SKIPPED, and the check-in is
# recorded as `submitted` rather than `notified`. No error surfaces.
RESEND_API_KEY=
RESEND_FROM="Luxel <hola@luxel.cl>"

# ── Guest check-in identity encryption ──
# 32-byte key (hex or base64) that encrypts guest ID numbers at rest — required
# for the check-in ID field. Generate: openssl rand -hex 32
LUXEL_PII_KEY=

# ── Web → worker bridge (the ONLY WhatsApp vars the web app needs) ──
# The web app forwards handed-off chats by calling the worker's /send route, so
# it holds no WhatsApp credentials — just the worker URL and the shared token.
# Both unset → crew notifications fall back to email only.
WHATSAPP_WORKER_SEND_URL=
INTERNAL_SEND_TOKEN=

# ── WhatsApp Cloud API (worker-owned) ──
# ALL WhatsApp lives in the Cloudflare worker — both inbound (Meta webhook) and
# outbound. Set these as worker secrets (`wrangler secret put …`), NOT here:
#   WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID, WHATSAPP_ACCESS_TOKEN,
#   WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET, LUXEL_OPERATOR_WHATSAPP,
#   SUPABASE_URL, SUPABASE_SECRET_KEY, and INTERNAL_SEND_TOKEN (same value as above).

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog (optional external mirror) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── In-house monitoring (owned event store) ──
# The web app CAPTURES events into Supabase (analytics_events / leads). The
# operator DASHBOARD is a separate app — see apps/admin/.env.example.
# Salt used to one-way hash visitor IPs before storing (privacy). Set a random value.
LUXEL_ANALYTICS_SALT=

# ── Payments — set only the provider you actually use ──
# With none of them set the plan bar reports billing_not_configured and hides
# the activate button. That is intended, not a bug.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Transbank Webpay Plus — blank off production uses the public integration
# (sandbox); production requires real credentials.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=

# ── Human-support working hours (America/Santiago; only gates the human handoff) ──
# LUXEL_WORKING_DAYS=1,2,3,4,5,6   # 0=Sun … 6=Sat (default Mon–Sat)
# LUXEL_WORKING_OPEN=9             # hour 0–23 (default 9)
# LUXEL_WORKING_CLOSE=19           # hour 0–23 (default 19)

# ── Dev-only stubs (NEVER set in production; real keys always take precedence) ──
# Simulate email notifications + AI drafting so the full host↔guest flow is
# testable without real Resend/OpenAI keys.
# LUXEL_DEV_MOCK=1
# Simulate payments — booking checkout AND AI-plan trial→active activation.
# LUXEL_DEV_MOCK_PAYMENTS=1
# Let Playwright bypass Clerk's dev-instance handshake in CI.
# E2E_SKIP_AUTH=1
