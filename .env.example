# ─────────────────────────────────────────────────────────────
# Servicios Luxel — environment variables (root reference).
# Copy this file to apps/web/.env.local for local dev.
#
# Variables left BLANK below are load-bearing: the feature they gate is off
# until they are set, usually silently. Variables that stay commented out are
# genuinely optional or dev-only.
#
# The operator app has its own file (apps/admin/.env.example), and worker
# secrets go via `wrangler secret put`. What breaks without each variable, and
# which of the four places it belongs in, is in docs/ENV.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# As of 2025 Supabase replaced the JWT-based anon/service_role keys with opaque
# tokens prefixed `sb_publishable_*` and `sb_secret_*`. Use the new keys; the
# code falls back to the legacy names below during the rotation window.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks (only set if you haven't rotated yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook signing secret for Clerk → /api/webhooks/clerk (used by svix to verify)
CLERK_WEBHOOK_SECRET=
# Dedicated auth pages (avoids the sign-in modal). After auth, land on the account.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# ── AI concierge ("Lux") — OpenAI ──
# Powers the guest auto-replies and the in-app assistant. Without this key
# getOpenAI() returns null and the assistant answers NOTHING — no error is
# raised anywhere, it simply stops responding.
OPENAI_API_KEY=
# The model is pinned in apps/web/src/lib/ai/client.ts. There is no env override:
# a silent per-environment model difference is worse than an edit and a deploy.
# Public WhatsApp number (E.164, e.g. 56912345678) used for human handoff links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Channel: the PMS mirror ──
# ONE central Luxel account holds every host's listings; hosts grant Luxel access
# and never log into the PMS themselves. This token IS that central operator
# credential — not a dev fallback. Which listings a customer can see is decided
# by listing_assignments, never by the token.
#
# Named for the role, not the vendor, so a future provider is a plugin rather
# than a rename. The old HOSPITABLE_API_TOKEN is still read as a fallback, so it
# can be removed at any time without a matching deploy.
#
# ROTATING IT: set the new value here and leave the PREVIOUS value in
# HOSPITABLE_API_TOKEN until every stored connection has been re-made. Tenancy
# scope is decided by asking whether a stored token is one of ours, and a
# previous operator token that no longer matches anything is reclassified as a
# customer's OWN connection — which bypasses the assignment filter.
PROVIDER_API_KEY=

# Inbound webhook. Register it with NO secret of any kind in the URL:
#   https://<prod-host>/api/channels/hospitable
# There is nowhere to put one — Hospitable's webhook form has only Name and URL,
# and a query string is written to access logs on every delivery.
#
# Deliveries are authorised by SOURCE IP against their published range. On
# Vercel that is trustworthy: they overwrite x-forwarded-for to prevent
# spoofing. Override the range only if Hospitable moves it, so that stays a
# config fix rather than a deploy.
#
# That check is not what protects the guest threads. The handler takes NO
# content from the payload, only a reservation id, and reads the thread back
# from Hospitable — so a forged request costs an API call, not a fabricated
# message in a guest's inbox and in the AI's grounding.
# HOSPITABLE_WEBHOOK_IPS=38.80.170.0/24

# ── Dynamic pricing (PriceLabs) ──
# Also a single central account; dynamic pricing is part of every plan.
# Unset → the pricing panel reports unavailable.
PRICELABS_API_KEY=

# ── Outbound email (Resend) — check-in and cleaning-crew notifications ──
# Unset → emailConfigured() is false, sends are SKIPPED, and the check-in is
# recorded as `submitted` rather than `notified`. No error surfaces.
RESEND_API_KEY=
RESEND_FROM="Luxel <hola@luxel.cl>"

# ── Guest check-in identity encryption ──
# 32-byte key (hex or base64) that encrypts guest ID numbers at rest — required
# for the check-in ID field. Generate: openssl rand -hex 32
LUXEL_PII_KEY=

# ── Web → worker bridge (the ONLY WhatsApp vars the web app needs) ──
# The web app sends WhatsApp by calling the worker's /send route — handed-off
# chats to the operator, and Meta-approved templates to each property's
# conserjes and cleaning crew — so it holds no WhatsApp credentials, just the
# worker URL and the shared token. Both unset → no WhatsApp: a conserje with an
# email gets that instead; the cleaning crew is not notified. Template bodies:
# docs/ENV.md.
WHATSAPP_WORKER_SEND_URL=
INTERNAL_SEND_TOKEN=

# ── WhatsApp Cloud API (worker-owned) ──
# ALL WhatsApp lives in the Cloudflare worker — both inbound (Meta webhook) and
# outbound. Set these as worker secrets (`wrangler secret put …`), NOT here:
#   WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_VERIFY_TOKEN,
#   WHATSAPP_APP_SECRET, LUXEL_OPERATOR_WHATSAPP, SUPABASE_URL, SUPABASE_SECRET_KEY,
#   and INTERNAL_SEND_TOKEN (same value as above).

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog (optional external mirror) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── In-house monitoring (owned event store) ──
# The web app CAPTURES events into Supabase (analytics_events / leads). The
# operator DASHBOARD is a separate app — see apps/admin/.env.example.

# ── Human-support working hours (America/Santiago; only gates the human handoff) ──
# LUXEL_WORKING_DAYS=1,2,3,4,5,6   # 0=Sun … 6=Sat (default Mon–Sat)
# LUXEL_WORKING_OPEN=9             # hour 0–23 (default 9)
# LUXEL_WORKING_CLOSE=19           # hour 0–23 (default 19)

# ── Dev-only stubs (NEVER set in production; real keys always take precedence) ──
# Simulate email notifications + AI drafting so the full host↔guest flow is
# testable without real Resend/OpenAI keys.
# LUXEL_DEV_MOCK=1
# Let Playwright bypass Clerk's dev-instance handshake in CI.
# E2E_SKIP_AUTH=1
