# ─────────────────────────────────────────────────────────────
# Servicios Luxel — Operator app (@luxel/admin) environment.
# Reads the same Supabase (service role) and Clerk instance as the web app.
# Copy to .env.local for local dev.
# ─────────────────────────────────────────────────────────────

# ── Supabase (service role — server-only reads of analytics/leads/sessions) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (same instance as web) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ── Web app ──
# Public URL of @luxel/web. The diagnostics bench mints check-in and cleaning
# links that must open on the customer site, not on this host.
# Set in Vercel by infra/vercel/admin.ts, not by hand.
NEXT_PUBLIC_WEB_URL=https://serviciosluxel.cl

# ── Shared with @luxel/web (same values, set once as team-level shared vars) ──
# The guest inbox, listings and diagnostics moved here from the customer app and
# read the same integrations. LUXEL_PII_KEY must be byte-identical to web's: it
# decrypts the per-customer Hospitable tokens the web app encrypted.
# PROVIDER_API_KEY is the central Hospitable token: /listings reads the account
# with it, and /stays blocks and releases nights on a listing calendar. Without
# it the stays page loads but refuses to create or cancel a stay.
LUXEL_PII_KEY=
OPENAI_API_KEY=
PROVIDER_API_KEY=
# Legacy fallback for PROVIDER_API_KEY:
# HOSPITABLE_API_TOKEN=
# Read only by the /debug status probe:
PRICELABS_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
WHATSAPP_WORKER_SEND_URL=
INTERNAL_SEND_TOKEN=

# ── Access control ──
# Operators = members of a Clerk organization. Add staff to that org in the Clerk
# dashboard; identify it by ID (most robust) or slug. Empty = locked.
# LUXEL_ADMIN_ORG_ID=org_...
LUXEL_ADMIN_ORG_SLUG=servicios-luxel-1783354109102489708
