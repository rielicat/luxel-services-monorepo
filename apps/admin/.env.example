# ─────────────────────────────────────────────────────────────
# Servicios Luxel — Operator app (@luxel/admin) environment.
# Reads the same Supabase (service role) and Clerk instance as the web app.
# Copy to .env.local for local dev.
# ─────────────────────────────────────────────────────────────

# ── Supabase (service role — server-only reads of analytics/leads/sessions) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (same instance as web) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ── Web app (optional) ──
# Public URL of @luxel/web. Used to link the operator to the guest inbox at
# /admin/inbox, where the AI drafts wait for approval.
# NEXT_PUBLIC_WEB_URL=https://serviciosluxel.cl

# ── Access control ──
# Operators = members of a Clerk organization. Add staff to that org in the Clerk
# dashboard; identify it by ID (most robust) or slug. Empty = locked.
# LUXEL_ADMIN_ORG_ID=org_...
LUXEL_ADMIN_ORG_SLUG=servicios-luxel-1783354109102489708
