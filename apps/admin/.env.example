# ─────────────────────────────────────────────────────────────
# Servicios Luxel — Operator app (@luxel/admin) environment.
# Reads the same Supabase (service role) and Clerk instance as the web app.
# Copy to .env.local for local dev.
# ─────────────────────────────────────────────────────────────

# ── Supabase (service role — server-only reads of analytics/leads/bookings) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (same instance as web) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ── Access control ──
# Access is granted by email DOMAIN — Luxel staff sign in with @serviciosluxel.cl
# addresses. Comma-separated; both domains and emails empty = locked.
LUXEL_ADMIN_DOMAINS=serviciosluxel.cl
# Optional: extra individual emails (external collaborators) beyond the domains.
LUXEL_ADMIN_EMAILS=
