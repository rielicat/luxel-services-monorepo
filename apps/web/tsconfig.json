{
  "extends": "@luxel/config/tsconfig/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "agent/**/*.ts",
    ".next/types/**/*.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "next.config.mjs"
  ],
  "exclude": ["node_modules", ".next", ".eve", ".output"]
}
