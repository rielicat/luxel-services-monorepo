# Copy to .env.local and fill in. See repo root .env.example for the full list.
# Supabase (2025+ keys: sb_publishable_* / sb_secret_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks during rotation:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Transbank Webpay Plus. Left blank -> the public integration (sandbox) is used
# off production; production requires real commerce credentials.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
# Set to "integration" to force the sandbox even when the above are set.
TRANSBANK_ENV=

# "Lux" AI concierge (OpenAI). Without a key the chat degrades gracefully.
OPENAI_API_KEY=
# Cost-optimized default; override for a stronger tier.
# OPENAI_MODEL=gpt-4o-mini
